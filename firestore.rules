rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function papel() {
      return exists(/databases/$(database)/documents/papeis/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/papeis/$(request.auth.token.email)).data.papel
        : '';
    }
    function ehEditor()   { return logado() && papel() == 'editor'; }
    function ehPostador() { return logado() && (papel() == 'editor' || papel() == 'postador'); }

    // Conteúdo público do site: qualquer um lê.
    // Agenda (eventos): editor e postador escrevem. Site e links: só editor.
    match /conteudo/eventos { allow read: if true; allow write: if ehPostador(); }
    match /conteudo/{doc}   { allow read: if true; allow write: if ehEditor(); }

    // Flyers (imagens em texto): qualquer um lê; editor e postador escrevem.
    match /flyers/{id} { allow read: if true; allow write: if ehPostador(); }

    // Quem pode o quê: cada pessoa lê só o próprio papel; só editor mexe na equipe.
    match /papeis/{email} {
      allow read: if logado() && (request.auth.token.email == email || ehEditor());
      allow write: if ehEditor();
    }
  }
}
